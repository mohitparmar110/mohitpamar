{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohitpamar",
  "compatibility_date": "2026-02-01",
  "main": "src/worker.js",
  "assets": {
    // Was "." — moved to ./public so config/source files at repo root
    // (this file, src/) are never served as public assets.
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PORTFOLIO_BUCKET",
      "bucket_name": "portfolio-bucket"
    }
  ],
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_live_TQCyJWTCHOy8MO"
  },
  "kv_namespaces": [
    {
      "binding": "AUDIT_KV",
      "id": "ead86eef8bfb48fdb34d5cb9708e4265"
    }
  ]
}
